{
  "name": "xinity-ai-gateway",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/gatewayServer.ts | pino-pretty",
    "build": "bun build --production --target=bun  --outdir=dist ./src/gatewayServer.ts",
    "build:compile": "bun build --compile --minify --target=bun ./src/gatewayServer.ts --outfile xinity-ai-gateway",
    "test": "bun test src/"
  },
  "devDependencies": {
    "@orpc/client": "catalog:orpc",
    "@orpc/openapi": "catalog:orpc",
    "@orpc/server": "catalog:orpc",
    "@orpc/zod": "catalog:orpc",
    "@types/bun": "catalog:",
    "@types/turndown": "^5.0.6",
    "common-db": "workspace:*",
    "common-log": "workspace:*",
    "xinity-infoserver": "workspace:*",
    "common-env": "workspace:*",
    "pino-pretty": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.47",
    "ai": "^6.0.182",
    "cheerio": "^1.2.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  }
}