{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"checkJs": false,
		"sourceMap": true,
		"strict": true,
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		},
		"types": [
			"$app/types",
			"bun"
		]
	},
	"exclude": [
		"src/lib/assets/code-examples/**/*.js"
	],
	"include": [
		"src",
		"vite.config.ts",
		"tests"
	]
}
