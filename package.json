{
  "name": "xinity-ai",
  "version": "0.24.1",
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "private": true,
  "scripts": {
    "bump": "bumpp --release conventional --git-check --all --commit --tag --push --execute 'bash scripts/update-changelog.sh'",
    "changelog:preview": "bunx git-cliff --unreleased",
    "lint": "bun --bun oxlint",
    "postinstall": "if [ -z \"$CI\" ]; then bunx simple-git-hooks@2; fi",
    "sync:dockerfiles": "bun scripts/sync-dockerfile-manifests.ts",
    "sync:dockerfiles:check": "bun scripts/sync-dockerfile-manifests.ts --check",
    "test:system": "bun test --timeout 60000 tests/system/"
  },
  "simple-git-hooks": {
    "commit-msg": "bunx --no-install commitlint --edit $1",
    "pre-commit": "git diff --cached --name-only --diff-filter=ACM -z | grep -zE '\\.(ts|tsx|js|jsx|mjs|cjs|svelte)$' | xargs -0 -r bun --bun oxlint"
  },
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "^1.3.14",
      "drizzle-orm": "^0.45.2",
      "pino": "^10.3.1",
      "pino-pretty": "^13.1.3",
      "postgres": "^3.4.9",
      "typescript": "^5.9.3",
      "zod": "^4.5.4"
    },
    "catalogs": {
      "orpc": {
        "@orpc/client": "^1.14.3",
        "@orpc/openapi": "^1.14.3",
        "@orpc/server": "^1.14.3",
        "@orpc/zod": "^1.14.3"
      }
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "bumpp": "^11.1.0",
    "oxlint": "^1.79.0"
  },
  "overrides": {
    "samlify": "2.13.1",
    "cookie": "^0.7.0",
    "esbuild": "0.28.2"
  }
}
