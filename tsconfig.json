{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "types": ["bun"],
    "paths": {
      "common-db": ["./packages/common-db/src/"],
      "common-env": ["./packages/common-env/src/"],
      "common-log": ["./packages/common-log/src/"]
    }
  },
  // Scoped deliberately: every package has its own tsconfig, and without an include this
  // one sweeps all of them with settings that are wrong for each.
  "include": ["tests/**/*", "scripts/**/*"]
}
