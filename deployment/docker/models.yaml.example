# yaml-language-server: $schema=https://sysinfo.xinity.ai/schemas/model.v2.json
# Xinity AI Model Configuration Example
# Copy this file to models.yaml and configure your models
# This file is mounted read-only into the infoserver container

# One entry describes one model on one engine, so the specifier carries the
# engine and the capacity numbers are correct for that exact build.
models:
  my-custom-llama-ollama:
    name: My Custom Llama
    # Purpose, strengths, limitations. Not a one-line label.
    description: |
      Llama 3.1 8B fine-tuned on our internal support corpus, so it answers in
      house terminology without prompting for it.

      Good for drafting replies and classifying tickets. Do not use it for
      general knowledge questions: the fine-tune narrowed it noticeably.
    url: https://example.com/models/my-custom-llama
    engine: ollama
    engineSpecifier: my-custom-llama:8b-q8_0
    weight: 8
    minKvCache: 2
    type: chat
    family: llama
    isCustom: true
    custom:
      baseModel: llama-3.1-8b
      extraFacts:
        training_dataset: proprietary-corpus
        training_date: "2024-01-10"

  local-embeddings-ollama:
    name: Local Embedding Model
    description: |
      Small embedding model for semantic search over our own documents, chosen so
      indexing a large corpus stays cheap.

      768-dimension output, English only. Multilingual content needs a different
      model.
    url: https://example.com/models/embeddings
    engine: ollama
    engineSpecifier: nomic-embed-text
    weight: 2
    minKvCache: 1
    type: embedding
    family: nomic

# Notes:
# - `weight` and `minKvCache` are in GB and describe this build only. A quantized
#   Ollama build and an fp16 vLLM build of the same model belong in separate
#   entries with separate numbers.
# - Local entries take precedence over anything pulled in through `includes`.
# - To extend the public registry, add an `includes` list pointing at
#   https://sysinfo.xinity.ai/models/v2.json once your instance is on a release
#   that serves it. An `includes` source must use the same format as this file.
# - The merged catalog is exposed at /api/v1/models and /models/v1.json.
